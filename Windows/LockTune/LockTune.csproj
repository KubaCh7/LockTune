<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 19041 SDK projections (media sessions); runs on Windows 10 1809+ and Windows 11. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share many type names; keep usings explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Lets the project build on Linux/macOS too (CI uses Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>LockTune</RootNamespace>
    <AssemblyName>LockTune</AssemblyName>
    <ApplicationIcon>Assets\LockTune.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>LockTune</Product>
    <Company>LockTune</Company>
    <Copyright>LockTune</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinForms-only advice; the WPF app sets DPI awareness in app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LockTune.ico" />
    <Resource Include="Assets\LockTune.png" />
  </ItemGroup>

</Project>
